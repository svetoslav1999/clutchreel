# Por defecto: texto normalizado con LF en el repositorio y en la copia de trabajo.
* text=auto eol=lf

# Scripts de Windows: siempre CRLF (cmd.exe falla con etiquetas y bloques si llegan con LF).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

